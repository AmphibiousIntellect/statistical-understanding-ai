{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amphibiousintellect.org/suai/v0.2/action.schema.json",
  "title": "SUAI v0.2 base action (DRAFT)",
  "description": "One exact, immutable proposed action. A changed action gets a new action_id and supersedes_action_id. `parameters` is deliberately open here; slice-specific extension schemas constrain it. `status` is the status at emission and is non-authoritative.",
  "type": "object",
  "required": [
    "schema_version", "action_id", "run_id", "finding_id", "action_type", "mutation_class", "title",
    "description", "approval_required", "statistical_implication", "target_inputs", "parameters",
    "affected", "value_capture_policy", "value_capture_rationale", "reversibility", "postconditions",
    "release_blocking", "affected_release_scope", "materiality_rationale", "alternative_group_id",
    "supersedes_action_id", "proposed_by", "proposed_at", "status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "action_id": {"$ref": "common.schema.json#/$defs/action_id"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "finding_id": {"$ref": "common.schema.json#/$defs/finding_id"},
    "action_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "mutation_class": {"$ref": "common.schema.json#/$defs/mutation_class"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "approval_required": {"type": "boolean"},
    "statistical_implication": {"type": ["string", "null"]},
    "target_inputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
    "parameters": {"type": "object"},
    "affected": {
      "type": "object",
      "properties": {
        "affected_record_count": {"type": "integer", "minimum": 0},
        "affected_cell_count": {"type": "integer", "minimum": 0},
        "record_references": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/record_reference"}},
        "value_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "before_sha256", "after_sha256"],
            "properties": {
              "ref": {"$ref": "common.schema.json#/$defs/record_reference"},
              "before_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
              "after_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        },
        "hash_method": {"type": "string", "minLength": 1},
        "hash_salt_policy": {"enum": ["none", "per_run_salt", "keyed"]},
        "redacted_previews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "before_preview", "after_preview", "redaction"],
            "properties": {
              "ref": {"$ref": "common.schema.json#/$defs/record_reference"},
              "before_preview": {"type": "string"},
              "after_preview": {"type": "string"},
              "redaction": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "full_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "before", "after"],
            "properties": {
              "ref": {"$ref": "common.schema.json#/$defs/record_reference"},
              "before": {},
              "after": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "value_capture_policy": {"$ref": "common.schema.json#/$defs/value_capture_policy"},
    "value_capture_rationale": {"type": ["string", "null"]},
    "reversibility": {
      "type": "object",
      "required": ["reversible", "method"],
      "properties": {
        "reversible": {"type": "boolean"},
        "method": {"enum": ["retain_input", "inverse_action", "none"]}
      },
      "additionalProperties": false
    },
    "postconditions": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "release_blocking": {"type": "boolean"},
    "affected_release_scope": {"$ref": "common.schema.json#/$defs/release_scope_ids"},
    "materiality_rationale": {"type": ["string", "null"]},
    "alternative_group_id": {"$ref": "common.schema.json#/$defs/alternative_group_id"},
    "supersedes_action_id": {"$ref": "common.schema.json#/$defs/nullable_action_id"},
    "proposed_by": {"$ref": "common.schema.json#/$defs/engine_ref"},
    "proposed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"$ref": "common.schema.json#/$defs/action_state"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"mutation_class": {"enum": ["metadata_only", "data_mutation"]}},
        "required": ["mutation_class"]
      },
      "then": {
        "properties": {
          "approval_required": {"const": true},
          "target_inputs": {"minItems": 1},
          "postconditions": {"minProperties": 1}
        }
      }
    },
    {
      "if": {"properties": {"value_capture_policy": {"const": "counts_only"}}, "required": ["value_capture_policy"]},
      "then": {"properties": {"affected": {"required": ["affected_record_count"]}}}
    },
    {
      "if": {"properties": {"value_capture_policy": {"const": "record_references"}}, "required": ["value_capture_policy"]},
      "then": {"properties": {"affected": {"required": ["record_references"], "properties": {"record_references": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"value_capture_policy": {"const": "hashes"}}, "required": ["value_capture_policy"]},
      "then": {
        "properties": {
          "affected": {
            "required": ["value_hashes", "hash_method", "hash_salt_policy"],
            "properties": {"value_hashes": {"minItems": 1}}
          }
        }
      }
    },
    {
      "if": {"properties": {"value_capture_policy": {"const": "redacted_preview"}}, "required": ["value_capture_policy"]},
      "then": {"properties": {"affected": {"required": ["redacted_previews"], "properties": {"redacted_previews": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"value_capture_policy": {"const": "full_values"}}, "required": ["value_capture_policy"]},
      "then": {
        "properties": {
          "affected": {"required": ["full_values"], "properties": {"full_values": {"minItems": 1}}},
          "value_capture_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"release_blocking": {"const": false}}, "required": ["release_blocking"]},
      "then": {"properties": {"materiality_rationale": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"release_blocking": {"const": true}}, "required": ["release_blocking"]},
      "then": {"properties": {"affected_release_scope": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
