{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amphibiousintellect.org/suai/v0.2/run-manifest.schema.json",
  "title": "SUAI v0.2 run manifest (DRAFT)",
  "description": "Links all artifacts of one run by run_id. It carries no state summary: current state is the replay of the audit stream it references. Release is evaluated per release scope.",
  "type": "object",
  "required": [
    "schema_version", "run_id", "started_at", "completed_at", "implementation_revision", "coordination_mode",
    "engines", "routing_policy", "inputs", "outputs", "engine_result_ids", "finding_ids", "action_ids",
    "approval_ids", "audit_log", "verification_status", "release_scopes"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "completed_at": {"$ref": "common.schema.json#/$defs/nullable_timestamp"},
    "implementation_revision": {"type": "string", "minLength": 1},
    "coordination_mode": {"$ref": "common.schema.json#/$defs/coordination_mode"},
    "engines": {"$ref": "common.schema.json#/$defs/engines"},
    "routing_policy": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
    "outputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
    "engine_result_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/engine_result_id"}, "uniqueItems": true},
    "finding_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding_id"}, "uniqueItems": true},
    "action_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/action_id"}, "uniqueItems": true},
    "approval_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/approval_id"}, "uniqueItems": true},
    "audit_log": {
      "type": "object",
      "required": ["path", "sha256", "event_count", "last_sequence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "event_count": {"type": "integer", "minimum": 1},
        "last_sequence": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "verification_status": {"$ref": "common.schema.json#/$defs/verification_status"},
    "release_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["release_scope_id", "description", "outputs", "release_status", "release_blockers"],
        "properties": {
          "release_scope_id": {"$ref": "common.schema.json#/$defs/release_scope_id"},
          "description": {"type": "string", "minLength": 1},
          "outputs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
          "release_status": {"enum": ["blocked", "releasable"]},
          "release_blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["blocker_code", "run_wide", "release_scope_ids", "detail"],
              "properties": {
                "blocker_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "run_wide": {"type": "boolean"},
                "release_scope_ids": {"$ref": "common.schema.json#/$defs/release_scope_ids"},
                "finding_id": {"$ref": "common.schema.json#/$defs/finding_id"},
                "action_id": {"$ref": "common.schema.json#/$defs/action_id"},
                "approval_id": {"$ref": "common.schema.json#/$defs/approval_id"},
                "detail": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {
                  "if": {"properties": {"run_wide": {"const": false}}, "required": ["run_wide"]},
                  "then": {"properties": {"release_scope_ids": {"minItems": 1}}}
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"release_status": {"const": "releasable"}}, "required": ["release_status"]},
            "then": {"properties": {"release_blockers": {"maxItems": 0}}}
          },
          {
            "if": {"properties": {"release_status": {"const": "blocked"}}, "required": ["release_status"]},
            "then": {"properties": {"release_blockers": {"minItems": 1}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {"$ref": "common.schema.json#/$defs/engine_participation_rules"},
    {
      "if": {"properties": {"verification_status": {"enum": ["not_run", "failed"]}}, "required": ["verification_status"]},
      "then": {"properties": {"release_scopes": {"items": {"properties": {"release_status": {"const": "blocked"}}}}}}
    }
  ],
  "additionalProperties": false
}
