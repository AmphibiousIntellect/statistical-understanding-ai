{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amphibiousintellect.org/suai/approval.schema.json",
  "title": "Statistical Data Manager approval",
  "type": "object",
  "required": [
    "approval_id",
    "finding_code",
    "decision",
    "decided_by",
    "decided_at",
    "rationale"
  ],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1},
    "finding_code": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected", "needs_context"]},
    "decided_by": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "conditions": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

