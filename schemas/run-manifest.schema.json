{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amphibiousintellect.org/suai/run-manifest.schema.json",
  "title": "Statistical Data Manager run manifest",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "implementation_revision",
    "inputs",
    "outputs",
    "verification_status"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "implementation_revision": {"type": "string", "minLength": 1},
    "engine": {"enum": ["r", "python", "cross-language"]},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "approval_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "verification_status": {"enum": ["not_run", "passed", "failed"]},
    "unresolved_finding_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

